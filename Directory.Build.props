<Project>
  <!--
    Build output goes into directories with the ".noindex" suffix: Spotlight
    refuses to index such directories natively and recursively. Without this
    the .NET apphost (a native Mach-O binary under bin/, e.g. ArkManager.App)
    shows up in Spotlight as an "application". A .metadata_never_index marker
    doesn't help here — it doesn't clear the already-indexed entries and runs
    asynchronously (racing mds).
    Applies to every project in the repo (Directory.Build.props is imported
    into each one).
  -->
  <PropertyGroup>
    <Version>1.1.4</Version>
    <BaseOutputPath>$(MSBuildProjectDirectory)/bin.noindex/</BaseOutputPath>
    <BaseIntermediateOutputPath>$(MSBuildProjectDirectory)/obj.noindex/</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
