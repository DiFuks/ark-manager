<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Uniform input-row height: Button/TextBox/NumericUpDown/ComboBox = 36px. Fluent defaults:
         Button ≈27, TextBox ≈32 — which made buttons "sit lower" than TextBox in the same row.
         We pin a shared MinHeight; content padding inside each control stays its own. -->
    <!-- ===== Buttons ===== -->
    <Style Selector="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
    <!-- Hover policy:
         - Secondary (ghost): the hover background must DEFINITELY differ from the parent
           (Panel2 was almost indistinguishable from Bg — the button "faded" on hover). We use
           LineBrush — lighter than both — plus brighten the border to AccentGlow.
         - Primary: Fluent's default :pointerover overrode Foreground with its own light colour —
           the dark AccentOn text became white on orange, which read poorly. We explicitly pin
           Foreground=AccentOn on hover. The hover Background goes slightly darker than accent
           (not lighter) — dark text already contrasts well on bright orange, and the brighter
           ink variant lit the background up more than needed.
         - Danger: warm red hover instead of dark. -->
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AccentGlowBrush}"/>
    </Style>
    <Style Selector="Button:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentInkBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentOnBrush}"/>
    </Style>
    <Style Selector="Button.primary:pointerover">
        <Setter Property="Foreground" Value="{StaticResource AccentOnBrush}"/>
    </Style>
    <Style Selector="Button.primary:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="TextElement.Foreground" Value="{StaticResource AccentOnBrush}"/>
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    </Style>
    <Style Selector="Button.icon:pointerover">
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
    </Style>
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
        <Setter Property="BorderBrush" Value="#4cd9685a"/>
    </Style>
    <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#1ed9685a"/>
        <Setter Property="BorderBrush" Value="#80d9685a"/>
    </Style>
    <Style Selector="Button.danger:pointerover">
        <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
    </Style>
    <Style Selector="Button.chip">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,7"/>
    </Style>

    <!-- PathIcon default sizing inside controls -->
    <Style Selector="PathIcon">
        <Setter Property="Width" Value="15"/>
        <Setter Property="Height" Value="15"/>
    </Style>

    <!-- ===== Panels / tiles ===== -->
    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
        <Setter Property="Padding" Value="18"/>
    </Style>
    <Style Selector="Border.tile">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="12,12"/>
    </Style>
    <Style Selector="Border.console">
        <Setter Property="Background" Value="{StaticResource ConsoleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="11"/>
    </Style>

    <!-- ===== Chips / pills ===== -->
    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Background" Value="{StaticResource OkSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource OkLineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="9,6"/>
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#40e08a2b"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- ===== Inputs ===== -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="9,0"/>
        <Setter Property="Height" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
    </Style>
    <!-- Multi-line "log" boxes (console on Server/RCON/Install): drop the fixed Height=36
         (it suppressed stretching inside Grid.Row="*") and the content centring, so lines
         start at the top and the textbox expands across all available height. -->
    <Style Selector="TextBox.log">
        <Setter Property="Height" Value="NaN"/>
        <Setter Property="VerticalAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <!-- Padding here insets the whole inner ScrollViewer (scroll bars included), so it can't
             keep text off the bars — the gutter has to go on PART_ScrollViewer instead (below). -->
        <Setter Property="Padding" Value="0"/>
    </Style>
    <!-- The floating scroll bars hover at the inner ScrollViewer's right/bottom edges. Padding on
         PART_ScrollViewer insets the text content (not the bars), so the bars land on an empty
         gutter instead of clipping the last line / right-most column. Left/top keep the text off
         the border and aligned under the "CONSOLE" header. -->
    <Style Selector="TextBox.log /template/ ScrollViewer#PART_ScrollViewer">
        <Setter Property="Padding" Value="14,6,16,14"/>
    </Style>
    <!-- NumericUpDown: surface = the inner TextBox (drawn by the regular TextBox style above →
         same background/border/corner-radius as text fields). ButtonSpinner is transparent and
         overlays the chevrons on the right (Themes/ControlThemes.axaml). Here we only reserve
         right-side padding inside the TextBox so the digits don't run under the chevrons. -->
    <!-- NumericUpDown is fully retemplated in Themes/ControlThemes.axaml (its "box" also lives
         there via AppButtonSpinner). We don't keep any styles for it here. -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style Selector="ToggleSwitch">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
    <Style Selector="ToggleSwitch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
    </Style>

    <!-- ===== ScrollViewer / ProgressBar ===== -->
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background" Value="{StaticResource LineBrush}"/>
    </Style>

    <!-- ===== Nav ListBox ===== -->
    <Style Selector="ListBox.nav">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem">
        <Setter Property="Padding" Value="11,9"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ListBox.nav ListBoxItem:selected">
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== Generic list rows (Backups/Mods) =====
         Suppress the Fluent default hover/selected on the ListBoxItem itself — otherwise the
         grey/blue template background poked out as "ears" at the tile corners (tile has
         CornerRadius 10, Fluent ListBoxItem has square corners → radius gaps in the corners).
         The hover/selected reaction is moved onto Border.tile inside the ItemTemplate. -->
    <Style Selector="ListBox.rows">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:pointerover Border.tile">
        <Setter Property="BorderBrush" Value="{StaticResource Line2Brush}"/>
    </Style>
    <Style Selector="ListBox.rows ListBoxItem:selected Border.tile">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="#40e08a2b"/>
    </Style>

    <!-- ===== Config tab strip (segmented look) =====
         Fully override the TabItem template: remove the Fluent "nub" (blue underline)
         and turn it into a "pill" with a soft accent background on the active item. -->
    <Style Selector="TabControl.seg">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="TabControl.seg TabItem">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="SegRoot" Background="Transparent" CornerRadius="8" Padding="13,7">
                    <ContentPresenter Content="{TemplateBinding Header}"
                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                      VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TabControl.seg TabItem:pointerover /template/ Border#SegRoot">
        <Setter Property="Background" Value="{StaticResource Panel2Brush}"/>
    </Style>
    <Style Selector="TabControl.seg TabItem:selected /template/ Border#SegRoot">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="TabControl.seg TabItem:selected">
        <Setter Property="Foreground" Value="{StaticResource AccentInkBrush}"/>
    </Style>
</Styles>
