<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Flat spinner button: a small transparent chip, hover = soft background, chevron glyph. -->
    <ControlTheme x:Key="SpinnerRepeatButton" TargetType="RepeatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="r" Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#r">
            <Setter Property="Background" Value="{DynamicResource Line2Brush}"/>
        </Style>
    </ControlTheme>

    <!-- Our ButtonSpinner: draws a rounded box using the same tokens as text fields
         (Panel2 + Line2 + radius 8), clips along the arc (square buttons don't chip off the corner),
         flat line chevrons. Assigned EXPLICITLY by key from the NumericUpDown ControlTheme below —
         an implicit `{x:Type ButtonSpinner}` template is overridden by NumericUpDown's own Theme. -->
    <ControlTheme x:Key="AppButtonSpinner" TargetType="ButtonSpinner">
        <Setter Property="Background" Value="{DynamicResource Panel2Brush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line2Brush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="MinHeight" Value="36"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto">
                        <ContentPresenter Name="PART_ContentPresenter" Grid.Column="0"
                                          Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,3,0"
                                    IsVisible="{TemplateBinding ShowButtonSpinner}">
                            <RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource SpinnerRepeatButton}">
                                <Path Width="11" Height="7" Stretch="Uniform"
                                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Data="M1,6 L6,1 L11,6"/>
                            </RepeatButton>
                            <RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource SpinnerRepeatButton}">
                                <Path Width="11" Height="7" Stretch="Uniform"
                                      Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                      StrokeLineCap="Round" StrokeJoin="Round" Data="M1,1 L6,6 L11,1"/>
                            </RepeatButton>
                        </StackPanel>
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- NumericUpDown retemplate: we replicate the standard structure (PART_Spinner + PART_TextBox)
         but EXPLICITLY hang our AppButtonSpinner on the spinner. The inner TextBox is transparent /
         borderless — the "box" is drawn by ButtonSpinner. NumericUpDown wires increment/edit logic
         to the parts by name, so behaviour is preserved. -->
    <ControlTheme x:Key="{x:Type NumericUpDown}" TargetType="NumericUpDown">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- Integer format: all our numeric fields are integers (ports, players, hours, minutes).
             Without this the spinner showed "7777,0" (extra decimal + locale comma). -->
        <Setter Property="FormatString" Value="0"/>
        <Setter Property="Template">
            <ControlTemplate>
                <DataValidationErrors>
                    <ButtonSpinner Name="PART_Spinner"
                                   Theme="{StaticResource AppButtonSpinner}"
                                   MinHeight="36"
                                   HorizontalContentAlignment="Stretch"
                                   VerticalContentAlignment="Center"
                                   AllowSpin="{TemplateBinding AllowSpin}"
                                   ShowButtonSpinner="{TemplateBinding ShowButtonSpinner}"
                                   ButtonSpinnerLocation="{TemplateBinding ButtonSpinnerLocation}">
                        <TextBox Name="PART_TextBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 Padding="9,0,4,0"
                                 MinHeight="0"
                                 MinWidth="40"
                                 PlaceholderText="{TemplateBinding Watermark}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}"
                                 AcceptsReturn="False"
                                 TextWrapping="NoWrap"
                                 VerticalContentAlignment="Center"/>
                    </ButtonSpinner>
                </DataValidationErrors>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
