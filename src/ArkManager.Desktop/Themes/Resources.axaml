<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://ArkManager/Themes/Tokens.axaml"/>
        <ResourceInclude Source="avares://ArkManager/Themes/Icons.axaml"/>
        <ResourceInclude Source="avares://ArkManager/Themes/ControlThemes.axaml"/>
    </ResourceDictionary.MergedDictionaries>
    <FontFamily x:Key="DisplayFont">avares://ArkManager/Assets/Fonts/#Zilla Slab</FontFamily>
    <FontFamily x:Key="UiFont">avares://ArkManager/Assets/Fonts/#IBM Plex Sans</FontFamily>
    <FontFamily x:Key="MonoFont">avares://ArkManager/Assets/Fonts/#IBM Plex Mono</FontFamily>
</ResourceDictionary>
