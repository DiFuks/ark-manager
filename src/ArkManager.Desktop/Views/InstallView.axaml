<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArkManager.App.ViewModels"
             x:Class="ArkManager.App.Views.InstallView"
             x:DataType="vm:InstallViewModel">
    <Grid RowDefinitions="auto,auto,*" RowSpacing="14">
        <TextBlock Grid.Row="0" Classes="h1" Text="Install"/>

        <StackPanel Grid.Row="1" Spacing="12">
            <!-- STEAMCMD -->
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,auto">
                        <TextBlock Grid.Column="0" Classes="section" Text="STEAMCMD" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" Fill="{Binding SteamCmdStatusBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SteamCmdStatusText}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Button Classes="primary" Content="{Binding SteamCmdActionLabel}"
                            Command="{Binding InstallSteamCmdCommand}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- ASA DEDICATED SERVER -->
            <Border Classes="panel">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,auto">
                        <TextBlock Grid.Column="0" Classes="section" Text="ASA DEDICATED SERVER" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Ellipse Width="8" Height="8" Fill="{Binding ServerStatusBrush}" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ServerStatusText}" FontWeight="SemiBold" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <TextBlock Text="Install path" Foreground="{DynamicResource MutedBrush}"/>
                    <Grid ColumnDefinitions="*,auto" ColumnSpacing="8">
                        <TextBox Grid.Column="0" Classes="mono" Text="{Binding ServerInstallPath}"/>
                        <Button Grid.Column="1" Classes="icon" Command="{Binding BrowseServerFolderCommand}" ToolTip.Tip="Browse"><PathIcon Data="{DynamicResource IconFolder}"/></Button>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="{Binding ServerPrimaryActionLabel}"
                                Command="{Binding InstallOrUpdateServerCommand}"/>
                        <Button Command="{Binding CheckForUpdatesCommand}" IsEnabled="{Binding !Busy}"
                                IsVisible="{Binding IsServerInstalled}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{DynamicResource IconRefresh}"/><TextBlock Text="Check for updates"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenServerFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <PathIcon Data="{DynamicResource IconFolder}"/><TextBlock Text="Show in Finder"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="4"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <Border Grid.Row="2" Classes="console">
            <Grid RowDefinitions="auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,auto,auto" Margin="14,9">
                    <TextBlock Grid.Column="0" Classes="section" Text="CONSOLE" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="icon" Command="{Binding CopyLogCommand}" ToolTip.Tip="Copy log" Margin="0,0,6,0"><PathIcon Data="{DynamicResource IconCopy}"/></Button>
                    <Button Grid.Column="2" Classes="icon" Command="{Binding ClearLogCommand}" ToolTip.Tip="Clear log"><PathIcon Data="{DynamicResource IconTrash}"/></Button>
                </Grid>
                <TextBox Grid.Row="1" x:Name="LogBox" Classes="log" Text="{Binding Log}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                         Background="Transparent" BorderThickness="0"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
