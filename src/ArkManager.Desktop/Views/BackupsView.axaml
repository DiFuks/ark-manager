<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArkManager.App.ViewModels"
             xmlns:bk="using:ArkManager.Core.Services.Backups"
             x:Class="ArkManager.App.Views.BackupsView"
             x:DataType="vm:BackupsViewModel">
    <Grid RowDefinitions="auto,auto,*,auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Text="Backups" FontSize="22" FontWeight="SemiBold"/>

        <DockPanel Grid.Row="1" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="💾 Create"
                    Command="{Binding CreateCommand}" IsEnabled="{Binding !Busy}" Padding="14,8"/>
            <TextBox Text="{Binding Note}" PlaceholderText="заметка (необязательно)"/>
        </DockPanel>

        <Border Grid.Row="2" CornerRadius="6" Background="#11141d">
            <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding Selected}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="bk:BackupInfo">
                        <Grid ColumnDefinitions="*,160,90">
                            <TextBlock Grid.Column="0" Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="1" Text="{Binding CreatedUtc, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                            <TextBlock Grid.Column="2" Text="{Binding SizeBytes}" HorizontalAlignment="Right" Opacity="0.7"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
            <Button Content="↺ Restore (с очисткой)" Command="{Binding RestoreCommand}" IsEnabled="{Binding !Busy}" Padding="14,8"/>
            <Button Content="🗑 Delete"               Command="{Binding DeleteCommand}"  Padding="14,8"/>
            <Button Content="📁 Open folder"          Command="{Binding OpenFolderCommand}" Padding="14,8"/>
            <Button Content="↻ Reload"                Command="{Binding ReloadCommand}"  Padding="14,8"/>
            <ProgressBar Width="200" Minimum="0" Maximum="1" Value="{Binding Progress}" IsVisible="{Binding Busy}" Height="6" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding AutoBackupStatus}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
