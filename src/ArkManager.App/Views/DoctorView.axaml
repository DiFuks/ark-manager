<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArkManager.App.ViewModels"
             xmlns:doc="using:ArkManager.Core.Services.Doctor"
             xmlns:cv="using:ArkManager.App.Converters"
             x:Class="ArkManager.App.Views.DoctorView"
             x:DataType="vm:DoctorViewModel">
    <Grid RowDefinitions="auto,auto,*,auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Text="Doctor" FontSize="22" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10">
            <Button Content="↻ Run checks" Command="{Binding RunCommand}" IsEnabled="{Binding !Busy}" Padding="14,8"/>
            <Button Content="⬇ Install wine (brew)" Command="{Binding InstallWineCommand}" IsEnabled="{Binding !Busy}" Padding="14,8"/>
            <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"/>
        </StackPanel>

        <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Border Grid.Column="0" CornerRadius="6" Background="#11141d" Padding="6">
                <ScrollViewer>
                    <ItemsControl ItemsSource="{Binding Results}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="doc:CheckResult">
                                <Border Padding="10,8" Margin="0,2" CornerRadius="4" Background="#181c28">
                                    <Grid ColumnDefinitions="24,*,*">
                                        <TextBlock Grid.Column="0" Text="{Binding Ok, Converter={x:Static cv:OkIcon.Instance}}" FontSize="14"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.75" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding FixHint}" FontSize="11" Opacity="0.6" TextWrapping="Wrap"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <Grid Grid.Column="1" RowDefinitions="auto,*" RowSpacing="4">
                <Button Grid.Row="0" Content="📋 Copy install log" Command="{Binding CopyInstallLogCommand}"
                        HorizontalAlignment="Right" Padding="8,2"/>
                <TextBox Grid.Row="1" x:Name="LogBox" Text="{Binding InstallLog}" IsReadOnly="True" AcceptsReturn="True"
                         TextWrapping="NoWrap" FontFamily="Menlo,Consolas,monospace" FontSize="11"
                         Background="#11141d" Padding="6"/>
            </Grid>
        </Grid>

        <ProgressBar Grid.Row="3" IsIndeterminate="True" IsVisible="{Binding Busy}" Height="4"/>
    </Grid>
</UserControl>
