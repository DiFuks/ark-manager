<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArkManager.App.ViewModels"
             x:Class="ArkManager.App.Views.InstallView"
             x:DataType="vm:InstallViewModel">
    <Grid RowDefinitions="auto,auto,auto,auto,*">
        <TextBlock Text="Install" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" CornerRadius="8" Padding="16" Background="#2a2f44" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <TextBlock Text="SteamCMD" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SteamCmdState}"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Install / Reinstall SteamCMD"
                            Command="{Binding InstallSteamCmdCommand}"
                            IsEnabled="{Binding !Busy}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="8" Padding="16" Background="#2a2f44" Margin="0,0,0,12">
            <StackPanel Spacing="8">
                <TextBlock Text="ASA Dedicated Server (Steam App 2430930)" FontWeight="SemiBold"/>
                <TextBlock Text="Путь установки:" Opacity="0.7"/>
                <DockPanel LastChildFill="True">
                    <Button DockPanel.Dock="Right" Content="📁..." Command="{Binding BrowseServerFolderCommand}"/>
                    <TextBox Text="{Binding ServerInstallPath}"/>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Install / Update server"
                            Command="{Binding InstallOrUpdateServerCommand}"
                            IsEnabled="{Binding !Busy}"/>
                    <Button Content="Открыть в Finder"
                            Command="{Binding OpenServerFolderCommand}"/>
                </StackPanel>
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding Busy}" Height="4"/>
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="Лог:" Opacity="0.7" Margin="0,8,0,4"/>
        <Border Grid.Row="4" CornerRadius="6" Background="#11141d" Padding="8">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Log}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Menlo,Consolas,monospace" FontSize="11"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
