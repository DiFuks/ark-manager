<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArkManager.App.ViewModels"
             x:Class="ArkManager.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <StackPanel Spacing="14">
        <TextBlock Text="Dashboard" FontSize="22" FontWeight="SemiBold"/>
        <Border CornerRadius="8" Padding="16" Background="#2a2f44">
            <Grid ColumnDefinitions="*,*" RowDefinitions="auto,auto,auto,auto,auto" RowSpacing="8" ColumnSpacing="20">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Состояние" Opacity="0.7"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ServerState}" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Сессия"   Opacity="0.7"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SessionName}"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="Runtime"  Opacity="0.7"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding LaunchMode}"/>
                <TextBlock Grid.Row="3" Grid.Column="0" Text="Сервер"   Opacity="0.7"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ServerPath}" TextWrapping="Wrap"/>
                <TextBlock Grid.Row="4" Grid.Column="0" Text="Моды"     Opacity="0.7"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ModCount}"/>
            </Grid>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="10">
            <Button Content="▶ Запустить"  Command="{Binding StartCommand}" Padding="14,8"/>
            <Button Content="■ Остановить" Command="{Binding StopCommand}"  Padding="14,8"/>
            <Button Content="↻ Обновить"   Command="{Binding RefreshCommand}" Padding="14,8"/>
        </StackPanel>
        <Border CornerRadius="8" Padding="12" Background="#262a3a">
            <TextBlock TextWrapping="Wrap" Opacity="0.85">
                <Run Text="Быстрый старт: 1) "/>
                <Run Text="Doctor" FontWeight="SemiBold"/>
                <Run Text=" → проверьте окружение. 2) "/>
                <Run Text="Install" FontWeight="SemiBold"/>
                <Run Text=" → поставьте SteamCMD и ASA-сервер. 3) "/>
                <Run Text="Config" FontWeight="SemiBold"/>
                <Run Text=" → задайте имя/порты/пароль. 4) "/>
                <Run Text="Server" FontWeight="SemiBold"/>
                <Run Text=" → нажмите Start. "/>
            </TextBlock>
        </Border>
    </StackPanel>
</UserControl>
