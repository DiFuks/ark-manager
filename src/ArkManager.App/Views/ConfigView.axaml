<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArkManager.App.ViewModels"
             x:Class="ArkManager.App.Views.ConfigView"
             x:DataType="vm:ConfigViewModel">
    <Grid RowDefinitions="auto,*,auto">
        <TextBlock Grid.Row="0" Text="Configuration" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TabControl Grid.Row="1">
            <TabItem Header="Основное">
                <ScrollViewer Padding="6">
                    <StackPanel Spacing="10" Margin="6">
                        <Grid ColumnDefinitions="180,*" RowDefinitions="auto,auto,auto,auto,auto,auto" RowSpacing="8" ColumnSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Map"             VerticalAlignment="Center"/>
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="8">
                                <ComboBox Grid.Column="0"
                                          ItemsSource="{Binding KnownMaps}"
                                          SelectedItem="{Binding SelectedMap}"
                                          PlaceholderText="Preset..."/>
                                <TextBox Grid.Column="1" Text="{Binding Map}" PlaceholderText="custom map"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Session name"    VerticalAlignment="Center"/>
                            <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding SessionName}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Max players"     VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaxPlayers}" Minimum="1" Maximum="200"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Port"            VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding Port}" Minimum="1024" Maximum="65535"/>
                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Query port"      VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding QueryPort}" Minimum="1024" Maximum="65535"/>
                            <TextBlock Grid.Row="5" Grid.Column="0" Text="RCON enabled"    VerticalAlignment="Center"/>
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <CheckBox IsChecked="{Binding RconEnabled}" Content="Enable"/>
                                <NumericUpDown Value="{Binding RconPort}" Minimum="1024" Maximum="65535" Width="160"/>
                            </StackPanel>
                        </Grid>
                        <Separator/>
                        <TextBlock Text="Пароли" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="180,*" RowDefinitions="auto,auto,auto" RowSpacing="8" ColumnSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Server password"     VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding ServerPassword}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Admin password"      VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding AdminPassword}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Spectator password"  VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="2" Grid.Column="1" Text="{Binding SpectatorPassword}"/>
                        </Grid>
                        <Separator/>
                        <TextBlock Text="Дополнительно" FontWeight="SemiBold"/>
                        <CheckBox IsChecked="{Binding NoBattlEye}"      Content="-NoBattlEye (обязательно для Wine)"/>
                        <CheckBox IsChecked="{Binding AutoManagedMods}" Content="-automanagedmods (авто-скачивание модов)"/>
                        <Separator/>
                        <TextBlock Text="Кластер" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="180,*" RowDefinitions="auto,auto" RowSpacing="8" ColumnSpacing="12">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Cluster ID" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding ClusterId}" PlaceholderText="общий для серверов кластера"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Cluster dir override" VerticalAlignment="Center"/>
                            <TextBox   Grid.Row="1" Grid.Column="1" Text="{Binding ClusterDirOverride}" PlaceholderText="опционально"/>
                        </Grid>
                        <Separator/>
                        <TextBlock Text="Extra CLI args" Opacity="0.7"/>
                        <TextBox Text="{Binding ExtraCommandLineArgs}"/>
                        <TextBlock Text="Extra ?query-string params (разделять '?')" Opacity="0.7"/>
                        <TextBox Text="{Binding ExtraQueryString}"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Rates">
                <ScrollViewer Padding="6">
                    <StackPanel Spacing="8" Margin="6">
                        <TextBlock Text="Сложность" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="260,160,*" ColumnSpacing="10" RowDefinitions="auto,auto" RowSpacing="6">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="DifficultyOffset" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding DifficultyOffset}" Increment="0.1" Minimum="0" Maximum="10"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="0..1, обычно 1.0" Opacity="0.6" VerticalAlignment="Center"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="OverrideOfficialDifficulty" VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding OverrideOfficialDifficulty}" Increment="1" Minimum="0" Maximum="30"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="5 = max wild dino level 150" Opacity="0.6" VerticalAlignment="Center"/>
                        </Grid>
                        <Separator/>
                        <TextBlock Text="Множители" FontWeight="SemiBold"/>
                        <Grid ColumnDefinitions="260,160" ColumnSpacing="10" RowSpacing="6"
                              RowDefinitions="auto,auto,auto,auto,auto,auto,auto,auto,auto,auto,auto">
                            <TextBlock Grid.Row="0"  Grid.Column="0" Text="TamingSpeedMultiplier"             VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="0"  Grid.Column="1" Value="{Binding TamingSpeedMultiplier}"             Increment="0.5" Minimum="0.1" Maximum="100"/>
                            <TextBlock Grid.Row="1"  Grid.Column="0" Text="XPMultiplier"                      VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="1"  Grid.Column="1" Value="{Binding XPMultiplier}"                      Increment="0.5" Minimum="0.1" Maximum="100"/>
                            <TextBlock Grid.Row="2"  Grid.Column="0" Text="HarvestAmountMultiplier"           VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="2"  Grid.Column="1" Value="{Binding HarvestAmountMultiplier}"           Increment="0.5" Minimum="0.1" Maximum="100"/>
                            <TextBlock Grid.Row="3"  Grid.Column="0" Text="DayCycleSpeedScale"                VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="3"  Grid.Column="1" Value="{Binding DayCycleSpeedScale}"                Increment="0.1" Minimum="0.1" Maximum="10"/>
                            <TextBlock Grid.Row="4"  Grid.Column="0" Text="DayTimeSpeedScale"                 VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="4"  Grid.Column="1" Value="{Binding DayTimeSpeedScale}"                 Increment="0.1" Minimum="0.1" Maximum="10"/>
                            <TextBlock Grid.Row="5"  Grid.Column="0" Text="NightTimeSpeedScale"               VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="5"  Grid.Column="1" Value="{Binding NightTimeSpeedScale}"               Increment="0.1" Minimum="0.1" Maximum="10"/>
                            <TextBlock Grid.Row="6"  Grid.Column="0" Text="Dino FoodDrainMultiplier"          VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="6"  Grid.Column="1" Value="{Binding DinoCharacterFoodDrainMultiplier}"  Increment="0.1" Minimum="0.1" Maximum="10"/>
                            <TextBlock Grid.Row="7"  Grid.Column="0" Text="Player FoodDrainMultiplier"        VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="7"  Grid.Column="1" Value="{Binding PlayerCharacterFoodDrainMultiplier}" Increment="0.1" Minimum="0.1" Maximum="10"/>
                            <TextBlock Grid.Row="8"  Grid.Column="0" Text="MatingIntervalMultiplier"          VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="8"  Grid.Column="1" Value="{Binding MatingIntervalMultiplier}"          Increment="0.1" Minimum="0.1" Maximum="10"/>
                            <TextBlock Grid.Row="9"  Grid.Column="0" Text="EggHatchSpeedMultiplier"           VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="9"  Grid.Column="1" Value="{Binding EggHatchSpeedMultiplier}"           Increment="0.5" Minimum="0.1" Maximum="100"/>
                            <TextBlock Grid.Row="10" Grid.Column="0" Text="BabyMatureSpeedMultiplier"         VerticalAlignment="Center"/>
                            <NumericUpDown Grid.Row="10" Grid.Column="1" Value="{Binding BabyMatureSpeedMultiplier}"         Increment="0.5" Minimum="0.1" Maximum="100"/>
                        </Grid>
                        <Button Content="💾 Save rates" Command="{Binding SaveRatesCommand}" Padding="14,8" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="GameUserSettings.ini">
                <TextBox Text="{Binding GameUserSettingsRaw}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Menlo,Consolas,monospace" FontSize="12"/>
            </TabItem>
            <TabItem Header="Game.ini">
                <TextBox Text="{Binding GameIniRaw}" AcceptsReturn="True" TextWrapping="NoWrap"
                         FontFamily="Menlo,Consolas,monospace" FontSize="12"/>
            </TabItem>
            <TabItem Header="Preview CLI">
                <ScrollViewer>
                    <TextBlock Text="{Binding CommandLinePreview}" TextWrapping="Wrap"
                               FontFamily="Menlo,Consolas,monospace" FontSize="12" Margin="8"/>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0">
            <Button Content="💾 Save"           Command="{Binding SaveCommand}" Padding="14,8"/>
            <Button Content="💾 Save ini files" Command="{Binding SaveIniFilesCommand}" Padding="14,8"/>
            <Button Content="↻ Reload"         Command="{Binding ReloadCommand}" Padding="14,8"/>
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
