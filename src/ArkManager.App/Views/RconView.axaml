<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ArkManager.App.ViewModels"
             x:Class="ArkManager.App.Views.RconView"
             x:DataType="vm:RconViewModel">
    <Grid RowDefinitions="auto,auto,*,auto" RowSpacing="10">
        <TextBlock Grid.Row="0" Text="RCON" FontSize="22" FontWeight="SemiBold"/>
        <Grid Grid.Row="1" ColumnDefinitions="*,90,*,auto,auto" ColumnSpacing="8">
            <TextBox Grid.Column="0" Text="{Binding Host}"     PlaceholderText="host"/>
            <NumericUpDown Grid.Column="1" Value="{Binding Port}" Minimum="1" Maximum="65535"/>
            <TextBox Grid.Column="2" Text="{Binding Password}" PlaceholderText="admin password" PasswordChar="•"/>
            <Button  Grid.Column="3" Content="Connect"    Command="{Binding ConnectCommand}"    IsEnabled="{Binding !Connected}"/>
            <Button  Grid.Column="4" Content="Disconnect" Command="{Binding DisconnectCommand}" IsEnabled="{Binding Connected}"/>
        </Grid>
        <Border Grid.Row="2" CornerRadius="6" Background="#0d0f17" Padding="6">
            <ScrollViewer>
                <ItemsControl ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontFamily="Menlo,Consolas,monospace" FontSize="11" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
        <Grid Grid.Row="3" ColumnDefinitions="*,auto,auto,auto,auto" ColumnSpacing="6">
            <TextBox Grid.Column="0" Text="{Binding Command}" PlaceholderText="RCON command (e.g. ListPlayers)"/>
            <Button  Grid.Column="1" Content="Send"      Command="{Binding SendCommand}"      IsEnabled="{Binding Connected}"/>
            <Button  Grid.Column="2" Content="saveworld" Command="{Binding SaveworldCommand}" IsEnabled="{Binding Connected}"/>
            <Button  Grid.Column="3" Content="DoExit"    Command="{Binding DoExitCommand}"    IsEnabled="{Binding Connected}"/>
            <Button  Grid.Column="4" Content="🗑"        Command="{Binding ClearCommand}"/>
        </Grid>
    </Grid>
</UserControl>
