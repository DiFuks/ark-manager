---
import Icon from './Icon.astro';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const cards = [
  { id: 'mac',   os: 'macOS',   arch: 'arm64', format: '.zip',    icon: 'apple'   },
  { id: 'linux', os: 'Linux',   arch: 'x64',   format: '.tar.gz', icon: 'linux'   },
  { id: 'win',   os: 'Windows', arch: 'x64',   format: '.zip',    icon: 'windows' },
] as const;

const { lang } = Astro.props;
const t = useTranslations(lang);
const d = t.download;
const fl = d.firstLaunch;
---
<section id="download">
  <div class="container">
    <p class="section-label">{d.label}</p>
    <h2 class="h2">{d.heading}</h2>
    <p class="meta dl-meta">
      <span id="dl-version">{d.latest}</span>
      <span id="dl-date" data-released={d.released}></span>
    </p>

    <div class="grid">
      {cards.map(c => (
        <article
          class="panel dl-card"
          data-os={c.id}
          data-note={c.id === 'mac' ? d.noteIntel : c.id === 'linux' ? d.noteArm : undefined}
        >
          <div class="dl-head">
            <Icon name={c.icon} size={28} class="dl-icon" />
            <div>
              <h3 class="dl-os">{c.os}</h3>
              <p class="meta dl-arch">{c.arch} · {c.format}</p>
            </div>
          </div>
          <p class="meta dl-size">— MB</p>
          <a class="btn primary dl-btn" href="https://github.com/DiFuks/ark-manager/releases/latest" target="_blank" rel="noopener">
            <Icon name="download" size={18} /> {d.button}
          </a>
          <p class="meta dl-note"></p>
        </article>
      ))}
    </div>

    <p class="meta dl-all">
      <a href="https://github.com/DiFuks/ark-manager/releases" target="_blank" rel="noopener">{d.allReleases}</a>
    </p>

    <div class="first-launch panel">
      <p class="section-label">{fl.label}</p>
      <p class="fl-body">{fl.body}</p>

      <div class="fl-grid">
        <div class="fl-col">
          <h4 class="fl-os">{fl.macTitle}</h4>
          <p class="fl-step" set:html={fl.macStep}></p>
          <pre class="fl-code"><code>xattr -dr com.apple.quarantine /Applications/ArkManager.app</code></pre>
          <p class="fl-step muted">{fl.macNote}</p>
          <p class="fl-step muted" set:html={fl.macRosetta}></p>
        </div>

        <div class="fl-col">
          <h4 class="fl-os">{fl.winTitle}</h4>
          <p class="fl-step" set:html={fl.winStep}></p>
          <p class="fl-step muted">{fl.winNote}</p>
        </div>
      </div>
    </div>

    <div class="fl-help">
      <p class="meta">
        {d.help.text}
        <a href={d.help.href} target="_blank" rel="noopener">{d.help.cta}</a>
      </p>
      <p class="meta fl-logs-label" set:html={d.help.logsLabel}></p>
    </div>
  </div>
</section>

<style>
  .dl-meta { display: flex; gap: 12px; margin: 12px 0 40px; }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .dl-card {
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 200ms ease, background 200ms ease;
  }
  .dl-card.detected {
    border-color: var(--accent);
    background: linear-gradient(180deg, var(--accent-soft), transparent 80%), var(--panel);
  }
  .dl-card.detected .dl-btn { box-shadow: 0 0 32px var(--accent-glow); }
  .dl-head { display: flex; gap: 16px; align-items: flex-start; }
  .dl-icon { color: var(--accent-ink); flex-shrink: 0; }
  .dl-os {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    margin: 0;
    color: var(--text);
  }
  .dl-arch { margin: 4px 0 0; }
  .dl-size { margin: 0; }
  .dl-btn { align-self: flex-start; }
  .dl-note { margin: 4px 0 0; min-height: 1em; }
  .dl-all { margin: 32px 0 48px; text-align: center; }
  .dl-all a { color: var(--muted); }
  .dl-all a:hover { color: var(--accent-ink); }

  .first-launch { padding: 32px; }
  .fl-body { margin: 12px 0 32px; color: var(--muted); max-width: 60ch; }
  .fl-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .fl-col { min-width: 0; }
  .fl-os {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 12px;
    color: var(--text);
  }
  .fl-step {
    margin: 0 0 12px;
    color: var(--text);
    font-size: 14px;
    line-height: 1.6;
  }
  .fl-step.muted { color: var(--muted); }
  .fl-step strong { color: var(--accent-ink); font-weight: 600; }
  .fl-code {
    background: var(--console);
    border: 1px solid var(--line);
    border-radius: 6px;
    padding: 12px 14px;
    margin: 0 0 16px;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--accent-ink);
    line-height: 1.5;
  }
  .fl-code code { white-space: pre; }

  .fl-help {
    margin: 24px 0 0;
    text-align: center;
    color: var(--muted);
  }
  .fl-help > p { margin: 0; }
  .fl-help a { color: var(--accent-ink); white-space: nowrap; }
  .fl-help a:hover { text-decoration: underline; }
  .fl-logs-label { margin-top: 8px; }
  .fl-logs-label strong { color: var(--accent-ink); font-weight: 600; }

  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; }
    .fl-grid { grid-template-columns: 1fr; gap: 24px; }
  }
</style>

<script>
  import { detectOs, osLabel } from '../lib/os-detect';
  import { fetchLatestRelease, pickAsset, formatSize, formatDate, type OsKey } from '../lib/github';

  const os = detectOs();

  const heroCta = document.getElementById('hero-cta') as HTMLAnchorElement | null;

  if (os) {
    document
      .querySelector<HTMLElement>(`#download .dl-card[data-os="${os}"]`)
      ?.classList.add('detected');

    if (heroCta) {
      // Localized "Download for" prefix is stashed on the CTA by Hero.astro.
      const prefix = heroCta.dataset.dlPrefix ?? 'Download for';
      heroCta.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M11 3h2v10h3l-4 5-4-5h3V3ZM4 20h16v2H4v-2Z"/></svg> ${prefix} ${osLabel(os)}`;
    }
  }

  const ua = navigator.userAgent;
  const isIntelMac = /Mac/.test(ua) && /Intel/i.test(ua);
  const isLinuxArm = /Linux/.test(ua) && /(arm|aarch64)/i.test(ua);
  if (isIntelMac) {
    const card = document.querySelector<HTMLElement>('#download .dl-card[data-os="mac"]');
    const note = card?.querySelector('.dl-note');
    if (note && card?.dataset.note) note.textContent = card.dataset.note;
  }
  if (isLinuxArm) {
    const card = document.querySelector<HTMLElement>('#download .dl-card[data-os="linux"]');
    const note = card?.querySelector('.dl-note');
    if (note && card?.dataset.note) note.textContent = card.dataset.note;
  }

  const release = await fetchLatestRelease();
  if (release) {
    const ver = document.getElementById('dl-version');
    const date = document.getElementById('dl-date');
    if (ver) ver.textContent = release.tag_name;
    if (date) {
      const releasedWord = date.dataset.released ?? 'released';
      date.textContent = `· ${releasedWord} ${formatDate(release.published_at)}`;
    }

    (['mac', 'linux', 'win'] as OsKey[]).forEach(key => {
      const asset = pickAsset(release, key);
      if (!asset) return;
      const card = document.querySelector<HTMLElement>(`#download .dl-card[data-os="${key}"]`);
      const btn = card?.querySelector<HTMLAnchorElement>('.dl-btn');
      const size = card?.querySelector<HTMLElement>('.dl-size');
      if (btn) btn.href = asset.browser_download_url;
      if (size) size.textContent = formatSize(asset.size);
    });

    if (os && heroCta) {
      const detectedAsset = pickAsset(release, os);
      if (detectedAsset) {
        heroCta.href = detectedAsset.browser_download_url;
        heroCta.removeAttribute('target');
      }
    }
  }
</script>
