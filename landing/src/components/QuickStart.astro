---
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const steps = t.quickstart.steps;
---
<section id="quickstart">
  <div class="container">
    <p class="section-label">{t.quickstart.label}</p>
    <h2 class="h2">{t.quickstart.heading}</h2>
    <div class="grid">
      {steps.map((s, i) => (
        <article class="panel step">
          <div class="num">{i + 1}</div>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-body">{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .step { padding: 32px 24px; }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 16px;
  }
  .step-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 8px;
    color: var(--text);
  }
  .step-body {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>
