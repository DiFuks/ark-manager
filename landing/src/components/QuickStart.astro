---
const steps = [
  { n: '1', title: 'Install SteamCMD',   body: 'One-click bootstrap. No terminal.' },
  { n: '2', title: 'Install the server', body: 'Steam pulls 25 GB. Sit back.' },
  { n: '3', title: 'Configure',          body: 'Session name, admin password, ports. Defaults are sensible.' },
  { n: '4', title: 'Start',              body: 'Wine builds its prefix on first run (~30s on mac/linux).' },
];
---
<section id="quickstart">
  <div class="container">
    <p class="section-label">QUICK START</p>
    <h2 class="h2">Four steps. Two clicks each.</h2>
    <div class="grid">
      {steps.map(s => (
        <article class="panel step">
          <div class="num">{s.n}</div>
          <h3 class="step-title">{s.title}</h3>
          <p class="step-body">{s.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .step { padding: 32px 24px; }
  .num {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 56px;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 16px;
  }
  .step-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 8px;
    color: var(--text);
  }
  .step-body {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.5;
  }
</style>
