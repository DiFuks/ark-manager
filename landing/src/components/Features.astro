---
import Icon from './Icon.astro';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

// Icons are language-neutral; titles/bodies come from the dictionary in order.
const icons = ['download', 'mod', 'gear', 'archive', 'terminal', 'users', 'cluster', 'map'] as const;

const { lang } = Astro.props;
const t = useTranslations(lang);
const features = t.features.items.map((item, i) => ({ icon: icons[i], ...item }));
---
<section id="features">
  <div class="container">
    <p class="section-label">{t.features.label}</p>
    <h2 class="h2">{t.features.heading}</h2>
    <div class="grid">
      {features.map(f => (
        <article class="panel feature">
          <Icon name={f.icon} size={24} class="feature-icon" />
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-body">{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .feature { padding: 28px; }
  .feature-icon { color: var(--accent-ink); margin-bottom: 16px; }
  .feature-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 8px;
    color: var(--text);
  }
  .feature-body {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
</style>
