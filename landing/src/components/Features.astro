---
import Icon from './Icon.astro';

const features = [
  { icon: 'download',  title: 'SteamCMD install & update',  body: 'One click. Steam handles the 25 GB.' },
  { icon: 'mod',       title: 'CurseForge mods',            body: 'Add by ID. Names resolve automatically.' },
  { icon: 'gear',      title: 'ini editor',                 body: 'Form view for basics, raw tabs for the rest.' },
  { icon: 'archive',   title: 'Auto-backups',               body: 'Snapshot Saved/ on a timer. Only while running.' },
  { icon: 'terminal',  title: 'RCON client',                body: 'saveworld, DoExit, Broadcast — one click.' },
  { icon: 'users',     title: 'Live players',               body: 'Names and counts polled in the background.' },
  { icon: 'cluster',   title: 'Cluster support',            body: 'ClusterId + transfer dir, GUI-driven.' },
  { icon: 'map',       title: '7 map presets',              body: 'Plus raw Game.ini for mod maps.' },
] as const;
---
<section id="features">
  <div class="container">
    <p class="section-label">FEATURES</p>
    <h2 class="h2">Everything ASA admins reach for, in one place.</h2>
    <div class="grid">
      {features.map(f => (
        <article class="panel feature">
          <Icon name={f.icon} size={24} class="feature-icon" />
          <h3 class="feature-title">{f.title}</h3>
          <p class="feature-body">{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 24px;
    margin-top: 48px;
  }
  .feature { padding: 28px; }
  .feature-icon { color: var(--accent-ink); margin-bottom: 16px; }
  .feature-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 20px;
    margin: 0 0 8px;
    color: var(--text);
  }
  .feature-body {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.5;
  }
</style>
