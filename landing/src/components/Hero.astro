---
import Icon from './Icon.astro';
import { type Lang, useTranslations } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<section id="hero">
  <div class="container hero">
    <div class="hero-text">
      <h1 class="h1">ArkManager</h1>
      <div class="os-chips">
        <span class="chip"><Icon name="apple" size={14} /> macOS</span>
        <span class="chip"><Icon name="linux" size={14} /> Linux</span>
        <span class="chip"><Icon name="windows" size={14} /> Windows</span>
      </div>
      <p class="tagline">{t.hero.tagline}</p>
      <p class="lede">{t.hero.lede}</p>
      <div class="cta-stack">
        <div class="cta-row">
          <a id="hero-cta" class="btn primary" href="#download" data-dl-prefix={t.hero.downloadFor}>
            <Icon name="download" size={18} /> {t.hero.download}
          </a>
          <a class="btn" href="https://github.com/DiFuks/ark-manager" target="_blank" rel="noopener">
            <Icon name="github" size={18} /> {t.hero.github}
          </a>
        </div>
        <a class="cta-alt" href="#download">{t.hero.allPlatforms}</a>
      </div>
    </div>
    <div class="hero-shot">
      <img
        src={`${base}screenshots/server.png`}
        alt={t.hero.shotAlt}
        width="1600"
        height="1000"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: center;
  }
  .hero-text { min-width: 0; }
  .os-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 24px 0 32px;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 26px);
    color: var(--text);
    line-height: 1.3;
    margin: 0 0 16px;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    margin: 0 0 32px;
    max-width: 36ch;
  }
  .cta-stack { display: flex; flex-direction: column; gap: 16px; align-items: flex-start; }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; }
  .cta-alt {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    text-decoration: none;
  }
  .cta-alt:hover { color: var(--accent-ink); text-decoration: underline; }

  .hero-shot {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    border: 1px solid var(--line);
  }
  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
