---
import Icon from './Icon.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
---
<section id="hero">
  <div class="container hero">
    <div class="hero-text">
      <h1 class="h1">ArkManager</h1>
      <div class="os-chips">
        <span class="chip"><Icon name="apple" size={14} /> macOS</span>
        <span class="chip"><Icon name="linux" size={14} /> Linux</span>
        <span class="chip"><Icon name="windows" size={14} /> Windows</span>
      </div>
      <p class="tagline">Cross-platform dedicated server manager for ARK: Survival Ascended.</p>
      <p class="lede">
        No setup. No wine to install. No .NET runtime to install.
        Just download and run.
      </p>
      <div class="cta-row">
        <a id="hero-cta" class="btn primary" href="#download">
          <Icon name="download" size={18} /> Download
        </a>
        <a class="btn" href="https://github.com/DiFuks/ark-manager" target="_blank" rel="noopener">
          <Icon name="github" size={18} /> View on GitHub
        </a>
      </div>
    </div>
    <div class="hero-shot">
      <img
        src={`${base}screenshots/server.png`}
        alt="ArkManager Server tab screenshot"
        loading="eager"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 64px;
    align-items: center;
  }
  .hero-text { min-width: 0; }
  .os-chips {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin: 24px 0 32px;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(20px, 2.2vw, 26px);
    color: var(--text);
    line-height: 1.3;
    margin: 0 0 16px;
  }
  .lede {
    font-size: 18px;
    color: var(--muted);
    margin: 0 0 32px;
    max-width: 36ch;
  }
  .cta-row { display: flex; gap: 12px; flex-wrap: wrap; }

  .hero-shot {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    border: 1px solid var(--line);
  }
  .hero-shot img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; gap: 48px; }
  }
</style>
