---
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'ArkManager — cross-platform dedicated server manager for ARK: Survival Ascended',
  description = 'Cross-platform dedicated server manager for ARK: Survival Ascended. No setup, no wine to install, no .NET runtime to install. macOS, Linux, Windows.',
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '') + '/';
const siteOrigin = Astro.site ?? new URL('https://arkmanager.org');
const ogImage = new URL(`${base}og-image.png`, siteOrigin).toString();
const canonical = new URL(Astro.url.pathname, siteOrigin).toString();

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ArkManager',
  description,
  url: canonical,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'macOS, Linux, Windows',
  downloadUrl: 'https://github.com/DiFuks/ark-manager/releases/latest',
  softwareHelp: 'https://github.com/DiFuks/ark-manager',
  license: 'https://github.com/DiFuks/ark-manager/blob/main/LICENSE',
  image: ogImage,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Person', name: 'Dmitry Fuks', url: 'https://github.com/DiFuks' },
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#1a1611" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Search engine ownership verification.
         Google is verified via the public/google9a8e66d959572a73.html file. -->
    <meta name="yandex-verification" content="911b60ca34075021" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ArkManager — dedicated server manager for ARK: Survival Ascended" />
    <meta property="og:site_name" content="ArkManager" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Zilla+Slab:wght@600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
